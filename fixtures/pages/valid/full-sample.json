      "text": "A level 3 heading"
    },
    {
      "type": "callout",
      "variant": "tip",
      "title": "Exam tip",
      "text": "A stateful firewall tracks the state of connections."
    },
    {
      "type": "quote",
      "text": "Security is a process, not a product.",
      "source": "Bruce Schneier"
    },
